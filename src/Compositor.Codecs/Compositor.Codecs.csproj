<Project Sdk="Microsoft.NET.Sdk">

  <!-- PNG codec and the CPU compositor.
       SkiaSharp is used for image codecs only: it is cross-platform, so this project still builds
       and tests on ubuntu-latest, and its license (MIT) matches the upstream project's. -->

  <PropertyGroup>
    <RootNamespace>Compositor.Codecs</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="2.88.9" />

    <!-- SkiaSharp's own package carries the Windows and macOS native libraries but not the Linux
         one, so without this the ubuntu CI job fails at the first decode with
         "Unable to load shared library 'libSkiaSharp'". It must NOT be marked PrivateAssets=all:
         that stops it reaching Compositor.Tests, which is the project that actually runs the
         decodes, and the CI run showed exactly that: 77 failures, every one a DllNotFoundException. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="2.88.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Compositor.Core\Compositor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The blend functions and the non-separable helpers are internal because callers should go
         through LayerCompositor. The tests assert them directly: the numbers they produce are the
         sharpest check on the whole formulation (see BlendMathTests). -->
    <InternalsVisibleTo Include="Compositor.Tests" />
  </ItemGroup>

</Project>
