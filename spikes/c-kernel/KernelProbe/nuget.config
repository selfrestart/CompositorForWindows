<?xml version="1.0" encoding="utf-8"?>
<!--
  REQUIRED ON THIS MACHINE. Do not delete.

  This machine has a stale machine-wide NuGet config at
      C:\Program Files (x86)\NuGet\Config\Microsoft.VisualStudio.FallbackLocation.config
  which declares a fallback package folder that does not exist:
      <add key="Microsoft Visual Studio Fallback Folder" value="D:\Dev C++\Microsoft VS\NuGetPackages" />
  Any `dotnet build` on this machine therefore dies with:
      error MSB4018: ResolvePackageAssets 任务意外失败.
      NuGet.Packaging.Core.PackagingException: 无法找到回退包文件夹"D:\Dev C++\Microsoft VS\NuGetPackages"

  A nearer nuget.config wins over the machine-wide one, so clearing the list here
  repairs every build in this directory tree, with no admin rights and no download.
  See ../../02-toolchain.md, section 1.1.
-->
<configuration>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
